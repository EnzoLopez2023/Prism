{
  "name": "prism",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/bootstrap.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/bootstrap.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test test/**/*.test.ts",
    "legacy:import": "tsx scripts/legacy-import.ts",
    "legacy:reconcile": "tsx scripts/reconcile.ts",
    "recovery": "tsx scripts/recovery.ts",
    "claim:recover": "tsx scripts/recover-claim.ts",
    "check:no-postgres": "node scripts/check-no-postgres.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.25.0",
    "@azure/msal-react": "^3.0.20",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@ionic/react": "^8.8.19",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "ionicons": "^7.4.0",
    "jose": "^6.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.9"
  }
}
